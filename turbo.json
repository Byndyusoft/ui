{
  "$schema": "./node_modules/turbo/schema.json",
  "globalDependencies": ["rollup.hooks.config.mjs", "rollup.commonjs-output.mjs", "tsconfig.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "clean": {
      "dependsOn": ["^clean"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "lint:check": {
      "dependsOn": ["^lint:check"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"]
    },
    "eslint:check": {
      "dependsOn": ["^eslint:check"]
    },
    "eslint:fix": {
      "dependsOn": ["^lint:fix"]
    },
    "stylelint:check": {
      "dependsOn": ["^stylelint:check"]
    },
    "stylelint:fix": {
      "dependsOn": ["^stylelint:fix"]
    },
    "prettier:check": {
      "dependsOn": ["^prettier:check"]
    },
    "prettier:fix": {
      "dependsOn": ["^prettier:fix"]
    }
  }
}
