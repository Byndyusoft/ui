{
  "name": "@byndyusoft-ui/text-editor",
  "version": "0.0.1",
  "description": "Визуальный редактор Markdown библиотеки Byndyusoft UI",
  "keywords": [
    "byndyusoft",
    "byndyusoft-ui",
    "react",
    "text-editor",
    "markdown"
  ],
  "author": "Byndyusoft Frontend Developer <frontend@byndyusoft.com>",
  "homepage": "https://github.com/Byndyusoft/ui/tree/master/components/text-editor#readme",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "VERIFICATION.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Byndyusoft/ui.git"
  },
  "scripts": {
    "build": "rollup --config",
    "clean": "rimraf dist && rimraf .turbo",
    "lint:check": "npm run eslint:check && npm run prettier:check && npm run stylelint:check",
    "lint:fix": "npm run eslint:fix && npm run prettier:fix && npm run stylelint:fix",
    "eslint:check": "eslint src --config ../../eslint.config.js",
    "eslint:fix": "eslint src --config ../../eslint.config.js --fix",
    "prettier:check": "prettier --check \"**/*.{ts,tsx,mjs,css,scss,json}\"",
    "prettier:fix": "prettier --write \"**/*.{ts,tsx,mjs,css,scss,json}\"",
    "stylelint:check": "stylelint '**/*.{css,scss}' --allow-empty-input",
    "stylelint:fix": "stylelint '**/*.{css,scss}' --fix --allow-empty-input"
  },
  "bugs": {
    "url": "https://github.com/Byndyusoft/ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "dependencies": {
    "@byndyusoft-ui/use-debounced-callback": "0.0.1",
    "@byndyusoft-ui/use-isomorphic-layout-effect": "0.0.0",
    "@byndyusoft-ui/use-latest-ref": "1.0.1",
    "@byndyusoft-ui/use-resize-observer": "0.0.1",
    "@byndyusoft-ui/use-throttled-callback": "0.3.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0"
  }
}
